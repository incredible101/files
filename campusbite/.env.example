# Copy this file to ".env" and fill in real values before running the app.
# Never commit the real .env file to version control.

# Port the web server listens on
PORT=3000

# "production" turns on proxy trust (needed on Railway/Render etc.)
NODE_ENV=development

# MySQL / MariaDB connection. XAMPP defaults: user root, empty password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusbite

# Secret used to sign staff login tokens (JWT). The server refuses to start
# while this is missing or still the placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Used by `npm run seed` to create/reset the first staff account.
# The password must be at least 8 characters and not the placeholder.
STAFF_USERNAME=admin
STAFF_PASSWORD=change-this-password
